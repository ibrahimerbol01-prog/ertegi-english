{
  "tools": {
    "allowed": [
      "read_file", "read_many_files", "list_directory", "glob", "search_file_content",
      "write_file", "replace", "google_web_search", "web_fetch",
      "run_shell_command(bash ../team.sh)",
      "run_shell_command(git status)", "run_shell_command(git log)", "run_shell_command(git show)",
      "run_shell_command(git diff)", "run_shell_command(git fetch)", "run_shell_command(git pull)",
      "run_shell_command(git switch)", "run_shell_command(git checkout)", "run_shell_command(git branch)",
      "run_shell_command(git add)", "run_shell_command(git commit)", "run_shell_command(git restore)",
      "run_shell_command(git stash)", "run_shell_command(git rebase)", "run_shell_command(git config team.login)",
      "run_shell_command(git push -u origin)", "run_shell_command(git push origin)",
      "run_shell_command(git push --force-with-lease)",
      "run_shell_command(npm ci)", "run_shell_command(npm run)", "run_shell_command(npm test)",
      "run_shell_command(node)", "run_shell_command(ls)", "run_shell_command(cat)", "run_shell_command(mkdir)"
    ],
    "exclude": [
      "run_shell_command(git push origin main)", "run_shell_command(git push origin HEAD:main)",
      "run_shell_command(git push --force)", "run_shell_command(git push -f)",
      "run_shell_command(gh pr merge)", "run_shell_command(rm)", "run_shell_command(npm install)",
      "run_shell_command(npm publish)", "run_shell_command(curl)", "run_shell_command(wget)"
    ]
  }
}
